---
import type { CollectionEntry } from 'astro:content';
import { formatDate, categorySlug, url } from '../lib/utils';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, date, category, tags } = post.data;
---

<article class:list={[
  'group py-6 border-b transition-colors',
  featured && 'relative',
]} style="border-color: var(--color-border);">
  {featured && (
    <span class="absolute -left-0 top-6 text-[10px] tracking-widest px-1.5 py-0.5 rounded-sm hidden"
          style="background: var(--color-tag-bg); color: var(--color-accent);">
      掌柜推荐
    </span>
  )}

  <div class="flex items-center gap-3 text-xs mb-2" style="color: var(--color-text-muted);">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="opacity-40">·</span>
    <a href={url(`/categories/${categorySlug(category)}`)} class="category-badge hover:underline">
      {category}
    </a>
    {featured && (
      <>
        <span class="opacity-40">·</span>
        <span style="color: var(--color-accent);">掌柜推荐</span>
      </>
    )}
  </div>

  <h2 class="text-lg font-semibold mb-2 leading-snug" style="font-family: var(--font-serif);">
    <a href={url(`/blog/${post.slug}`)}
       class="transition-colors group-hover:opacity-80"
       style="color: var(--color-text);">
      {title}
    </a>
  </h2>

  <p class="text-sm leading-relaxed opacity-75 mb-3 line-clamp-2" style="color: var(--color-text-muted);">
    {description}
  </p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 4).map(tag => (
        <a href={url(`/tags/${encodeURIComponent(tag)}`)} class="tag">#{tag}</a>
      ))}
    </div>
  )}
</article>
