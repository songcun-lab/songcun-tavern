---
import { url } from '../lib/utils';

const navItems = [
  { href: '/',           label: '首页',     en: 'Home' },
  { href: '/blog',       label: '今晚酒单', en: 'Blog' },
  { href: '/categories', label: '分类',     en: 'Categories' },
  { href: '/archive',    label: '陈年旧酿', en: 'Archive' },
  { href: '/about',      label: '关于掌柜', en: 'About' },
  { href: '/now',        label: '近况',     en: 'Now' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = (Astro.url.pathname.replace(/\/$/, '') || '/').replace(base, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-bg) 92%, transparent); border-color: var(--color-border);">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14">

      <!-- Logo -->
      <a href={url('/')} class="flex items-baseline gap-2 group" aria-label="宋村清酒小酒馆 首页">
        <span class="text-lg font-semibold tracking-tight transition-opacity group-hover:opacity-80"
              style="color: var(--color-text); font-family: var(--font-serif);">
          宋村清酒小酒馆
        </span>
        <span class="hidden sm:inline text-[10px] tracking-[0.2em] uppercase opacity-40"
              style="color: var(--color-text-muted);">
          Tavern
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-0.5" aria-label="主导航">
        {navItems.map(item => (
          <a
            href={url(item.href)}
            class:list={[
              'px-3 py-1.5 text-sm rounded transition-all duration-200',
              isActive(item.href) ? 'font-medium' : 'opacity-70 hover:opacity-100',
            ]}
            style={isActive(item.href) ? 'color: var(--color-accent);' : 'color: var(--color-text);'}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="flex items-center gap-1">
        <a href={url('/search')} class="p-2 rounded opacity-60 hover:opacity-100 transition-opacity"
           style="color: var(--color-text);" aria-label="搜索">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </a>

        <button id="theme-toggle" class="p-2 rounded opacity-60 hover:opacity-100 transition-opacity"
                style="color: var(--color-text);" aria-label="切换深色模式">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="hidden dark:block">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="block dark:hidden">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>

        <button id="mobile-menu-toggle" class="md:hidden p-2 rounded opacity-60 hover:opacity-100 transition-opacity"
                style="color: var(--color-text);" aria-label="打开菜单" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t" style="border-color: var(--color-border); background-color: var(--color-bg);">
    <nav class="max-w-5xl mx-auto px-4 py-3 flex flex-col gap-1" aria-label="移动端导航">
      {navItems.map(item => (
        <a
          href={url(item.href)}
          class:list={[
            'px-3 py-2 text-sm rounded transition-all duration-200 flex items-baseline gap-2',
            isActive(item.href) ? 'font-medium' : 'opacity-70',
          ]}
          style={isActive(item.href) ? 'color: var(--color-accent);' : 'color: var(--color-text);'}
        >
          {item.label}
          <span class="text-[10px] tracking-widest uppercase opacity-40">{item.en}</span>
        </a>
      ))}
      <a href={url('/uses')} class="px-3 py-2 text-sm rounded opacity-70 flex items-baseline gap-2" style="color: var(--color-text);">
        工具箱 <span class="text-[10px] tracking-widest uppercase opacity-40">Uses</span>
      </a>
      <a href={url('/projects')} class="px-3 py-2 text-sm rounded opacity-70 flex items-baseline gap-2" style="color: var(--color-text);">
        项目 <span class="text-[10px] tracking-widest uppercase opacity-40">Projects</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  const menuBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const hidden = mobileMenu?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!hidden));
  });
</script>
