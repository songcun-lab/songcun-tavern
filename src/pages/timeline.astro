---
import { url } from '../lib/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const events = [
  { year: '1997', text: '从村庄走出来，进入大学，读矿山机电专业。那时候不知道，这个选择会让我和「矿」打二十多年交道。' },
  { year: '2001', text: '继续读研，转向技术经济与管理。开始意识到，工程之外还有另一套看世界的方法。' },
  { year: '2004', text: '进入中国矿业大学（北京）攻读管理学博士，研究煤炭投资决策模型。' },
  { year: '2007', text: '博士毕业，留在能源经济研究所做研究员。参与国家煤炭产业政策基础研究，跑遍全国产煤省份。' },
  { year: '2009', text: '进入大型能源央企做煤炭战略投资，同年被借调到国家能源局煤炭司，一待五年。参与国家煤炭产业政策和「十二五」规划起草。' },
  { year: '2014', text: '结束借调回到企业，作为驻场项目经理进驻千万吨级煤矿建设现场。从写政策的人，变成盯工地的人。' },
  { year: '2016', text: '回到总部，先后负责法务风控、生产技术等条线。学会了在大组织里把复杂的事情理顺。' },
  { year: '2021', text: '到内蒙古鄂尔多斯，担任总投资 71 亿元特大型煤矿的总经理和矿长。从 4 个人开始，从 0 到 1。' },
  { year: '2023', text: '煤矿项目获得国家发展改革委核准批复——当年内蒙古自治区唯一核准的特大型煤矿项目。' },
  { year: '2024', text: '人生中段经历重大转折。离开体制，加入工业互联网软件企业，从头开始做市场。同年，开始认真学习 AI。' },
  { year: '2025', text: '系统搭建自己的 AI 工作流和知识体系。与伙伴创办环保水凝胶抑尘剂公司，进入工业抑尘领域。每天在朋友圈输出一篇 AI 学习感悟，一天没断过。' },
  { year: '2026', text: '创建 Songcun Lab，把 AI 学习从「使用工具」推进到「搭建个人 AI 基础设施」。开了这间小酒馆，把路上的事记下来。' },
];
---

<BaseLayout title="人生时间线" description="从村庄到矿山，再到 AI——宋村博士的人生时间线。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-12">
      <p class="text-[10px] tracking-widest uppercase opacity-40 mb-2" style="color: var(--color-text-muted);">
        Timeline
      </p>
      <h1 class="text-3xl font-bold mb-4" style="color: var(--color-text); font-family: var(--font-serif);">
        人生时间线
      </h1>
      <p class="text-sm leading-relaxed opacity-70 max-w-lg" style="color: var(--color-text-muted);">
        从村庄到矿山，再到 AI。不是每一步都走对了，但每一步都算数。
      </p>
    </header>

    <div class="relative border-l-2 pl-8 space-y-10" style="border-color: var(--color-border);">
      {events.map(ev => (
        <div class="relative">
          <span class="absolute -left-[41px] top-1 w-4 h-4 rounded-full border-2"
                style="background: var(--color-bg); border-color: var(--color-accent);"></span>
          <p class="text-sm font-semibold tracking-wider mb-2" style="color: var(--color-accent); font-family: var(--font-serif);">
            {ev.year}
          </p>
          <p class="text-sm leading-loose opacity-80" style="color: var(--color-text-muted);">
            {ev.text}
          </p>
        </div>
      ))}
    </div>

    <p class="mt-16 text-center text-sm opacity-50 leading-loose" style="color: var(--color-text-muted); font-family: var(--font-serif);">
      故事还在继续。<br />
      <a href={url('/ai-journey')} class="hover:underline" style="color: var(--color-accent);">→ 看看 AI 这条线上发生了什么</a>
    </p>
  </div>
</BaseLayout>
