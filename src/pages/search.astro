---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="在宋村清酒小酒馆中搜索文章。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-8">
      <h1 class="text-3xl font-bold mb-3" style="color: var(--color-text); font-family: var(--font-serif);">
        找一杯酒
      </h1>
      <p class="text-sm opacity-60" style="color: var(--color-text-muted);">
        输入关键词，搜索全站文章。
      </p>
    </header>

    <input
      id="search-input"
      type="search"
      placeholder="搜索标题、描述、标签…"
      autocomplete="off"
      class="w-full px-4 py-3 rounded-lg border text-base outline-none transition-colors focus:border-current"
      style="background: var(--color-bg-secondary); border-color: var(--color-border); color: var(--color-text);"
    />

    <div id="search-results" class="mt-8 space-y-5"></div>
    <p id="search-empty" class="hidden text-center py-12 opacity-60" style="color: var(--color-text-muted);">
      没找到这杯酒，换个词试试。
    </p>
  </div>
</BaseLayout>

<script>
  import Fuse from 'fuse.js';

  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

  let fuse: Fuse<any> | null = null;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results')!;
  const emptyEl = document.getElementById('search-empty')!;

  async function initFuse() {
    if (fuse) return fuse;
    const res = await fetch(`${BASE}/search-index.json`);
    const data = await res.json();
    fuse = new Fuse(data, {
      keys: [
        { name: 'title', weight: 0.5 },
        { name: 'description', weight: 0.3 },
        { name: 'tags', weight: 0.15 },
        { name: 'category', weight: 0.05 },
      ],
      threshold: 0.35,
      ignoreLocation: true,
    });
    return fuse;
  }

  function render(results: any[]) {
    resultsEl.innerHTML = '';
    emptyEl.classList.toggle('hidden', results.length > 0 || !input.value.trim());
    for (const { item } of results.slice(0, 20)) {
      const el = document.createElement('a');
      el.href = `${BASE}/blog/${item.slug}`;
      el.className = 'block p-4 rounded-lg border transition-all hover:shadow-sm';
      el.style.borderColor = 'var(--color-border)';
      el.innerHTML = `
        <div class="text-xs mb-1" style="color: var(--color-accent);">${item.category} · ${item.date}</div>
        <div class="font-medium" style="color: var(--color-text);">${item.title}</div>
        <div class="text-sm mt-1 opacity-70" style="color: var(--color-text-muted);">${item.description}</div>
      `;
      resultsEl.appendChild(el);
    }
  }

  let timer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(async () => {
      const q = input.value.trim();
      if (!q) { render([]); return; }
      const f = await initFuse();
      render(f.search(q));
    }, 200);
  });

  // Preload index on focus
  input?.addEventListener('focus', () => { initFuse(); }, { once: true });
</script>
