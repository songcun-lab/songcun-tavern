---
import BaseLayout from '../layouts/BaseLayout.astro';

const phases = [
  {
    period: '第一阶段 · 把 AI 当强心剂',
    time: '2024 下半年 — 2025 初',
    body: '在人生最低谷的日子里遇到 ChatGPT。最初只是深夜睡不着时的对话对象，后来发现它真的能回答我的问题、陪我梳理思路。从"聊天"开始，慢慢把 ChatGPT、Claude、Kimi 用进了日常工作：写材料、做研究、整理行业信息。这个阶段的关键词是：使用。',
    repos: [],
  },
  {
    period: '第二阶段 · 每天输出，建立习惯',
    time: '2025',
    body: '开始每天在朋友圈和小红书输出一篇 AI 学习感悟，一天没断过。不为流量，只为记录。输出倒逼输入——为了写清楚一个概念，就必须真正搞懂它。这一年从 Prompt 写法、工具对比，一路学到 Agent、RAG、MCP 这些底层概念。这个阶段的关键词是：坚持。',
    repos: [],
  },
  {
    period: '第三阶段 · 从聊天到编程',
    time: '2025 底 — 2026 初',
    body: '第一次用 Claude Code 和 Codex 写代码，发现"氛围编程"（Vibe Coding）让一个非科班的人也能做出真正能跑的东西。注册了 GitHub 组织 Songcun Lab（栓柱 AI），开始把学习笔记、Prompt 库、Agent 实验放到公开仓库里。用 AI 给自己的创业公司做了官网。这个阶段的关键词是：动手。',
    repos: ['notes-ai-journey', 'codex-notes', 'agent-skills'],
  },
  {
    period: '第四阶段 · 搭建个人 AI 基础设施',
    time: '2026 上半年',
    body: '不再满足于零散地用工具，开始系统研究 Personal AI Infrastructure：研读 Claude Code 源码、拆解各家 AI 工具的系统提示词、跑通各种轻量 Agent 框架、用 Obsidian 搭建第二大脑，把 ChatGPT、Claude、Manus、Cowork 等工具串成稳定可复用的工作流。这个阶段的关键词是：体系。',
    repos: ['Personal_AI_Infrastructure', 'learn-claude-code', 'second-brain', 'ai-skill-index'],
  },
  {
    period: '第五阶段 · AI × 工业 × 创业',
    time: '2026 — 现在',
    body: '把 AI 能力带回自己最熟悉的领域：能源、煤炭、智能矿山、工业环保。一边在工业软件企业做 ToB 市场，一边探索 AI 在工业场景的落地，一边研究一人公司方法论、Skill 生态和模型训练基础理论。AI 学习不再是逃避现实的出口，而成了连接过去二十年积累和未来十年可能性的桥。这个阶段的关键词是：融合。',
    repos: ['one-person-businesses-methodology-v2.0', 'Illustrated-Agent-Skills', 'zhangxuefeng-skill'],
  },
];
---

<BaseLayout title="AI 学习时间线" description="一个 48 岁非科班中年人的 AI 学习轨迹：从深夜和 ChatGPT 聊天，到搭建自己的个人 AI 基础设施。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-12">
      <p class="text-[10px] tracking-widest uppercase opacity-40 mb-2" style="color: var(--color-text-muted);">
        AI Journey
      </p>
      <h1 class="text-3xl font-bold mb-4" style="color: var(--color-text); font-family: var(--font-serif);">
        AI 学习时间线
      </h1>
      <p class="text-sm leading-relaxed opacity-70 max-w-lg" style="color: var(--color-text-muted);">
        一个 48 岁、非计算机科班的中年人，是怎么一步一步学 AI 的。
        这条时间线来自我的真实学习记录和
        <a href="https://github.com/songcun-lab" target="_blank" rel="noopener noreferrer"
           class="hover:underline" style="color: var(--color-accent);">GitHub 提交轨迹</a>。
      </p>
    </header>

    <div class="space-y-10">
      {phases.map((phase, i) => (
        <section class="p-6 rounded-lg border" style="border-color: var(--color-border); background: var(--color-bg-secondary);">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
            <h2 class="text-lg font-semibold" style="color: var(--color-text); font-family: var(--font-serif);">
              {phase.period}
            </h2>
            <span class="text-xs opacity-50" style="color: var(--color-text-muted);">{phase.time}</span>
          </div>
          <p class="text-sm leading-loose opacity-80 mb-4" style="color: var(--color-text-muted);">
            {phase.body}
          </p>
          {phase.repos.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {phase.repos.map(repo => (
                <a href={`https://github.com/songcun-lab/${repo}`} target="_blank" rel="noopener noreferrer"
                   class="tag font-mono text-xs">
                  {repo}
                </a>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <section class="mt-14 text-center">
      <p class="text-base leading-loose opacity-60 max-w-md mx-auto"
         style="color: var(--color-text-muted); font-family: var(--font-serif);">
        AI 没有让我变年轻，<br />
        但让我重新对世界产生了好奇。
      </p>
      <p class="mt-6 text-xs tracking-[0.25em] uppercase opacity-30" style="color: var(--color-text-muted);">
        From Village to AGI
      </p>
    </section>
  </div>
</BaseLayout>
