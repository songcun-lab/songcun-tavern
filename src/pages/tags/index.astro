---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPublished, url } from '../../lib/utils';

const posts = filterPublished(await getCollection('posts'));
const tagCounts: Record<string, number> = {};
for (const p of posts) {
  for (const t of p.data.tags) {
    tagCounts[t] = (tagCounts[t] ?? 0) + 1;
  }
}
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="宋村清酒小酒馆的全部文章标签。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold mb-3" style="color: var(--color-text); font-family: var(--font-serif);">
        标签
      </h1>
      <p class="text-sm opacity-60" style="color: var(--color-text-muted);">
        共 {tags.length} 个标签
      </p>
    </header>

    <div class="flex flex-wrap gap-3">
      {tags.map(([tag, count]) => (
        <a href={url(`/tags/${encodeURIComponent(tag)}`)}
           class="tag text-sm px-3 py-1.5">
          #{tag}
          <span class="ml-1 opacity-60">{count}</span>
        </a>
      ))}
    </div>

    {tags.length === 0 && (
      <p class="text-center py-16 opacity-60" style="color: var(--color-text-muted);">
        暂无标签。
      </p>
    )}
  </div>
</BaseLayout>
