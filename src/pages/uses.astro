---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: '对话与研究',
    items: [
      { name: 'ChatGPT', note: '最早的入口，日常对话、思路梳理的主力。' },
      { name: 'Claude', note: '长文写作和深度分析首选，文字质感最好。' },
      { name: 'Gemini', note: '多模态和长上下文场景的补充。' },
      { name: 'Kimi', note: '中文资料检索和长文档阅读。' },
    ],
  },
  {
    title: 'AI 编程',
    items: [
      { name: 'Claude Code', note: '我的主力编程 Agent，从它开始学会了氛围编程。' },
      { name: 'Codex', note: '与 Claude Code 互为备份，各有擅长。' },
      { name: 'Cursor', note: '需要在 IDE 里精细改代码时用。' },
      { name: 'VS Code + WSL', note: '基础开发环境，Windows 下跑 Linux 工具链。' },
    ],
  },
  {
    title: 'Agent 与自动化',
    items: [
      { name: 'Manus', note: '复杂任务的通用 Agent：研究报告、网站、材料一站式完成。' },
      { name: 'Cowork', note: '多 Agent 协作的探索。' },
      { name: 'Skills / MCP', note: '把能力封装成可复用单元，是我最近研究的重点。' },
    ],
  },
  {
    title: '知识管理',
    items: [
      { name: 'Obsidian', note: '第二大脑。按「资料原文—加工输出—沉淀知识」组织。' },
      { name: 'GitHub', note: '所有学习成果的公开沉淀地，Songcun Lab 的家。' },
      { name: 'YouMind', note: '素材收集和内容创作的中转站。' },
    ],
  },
  {
    title: '内容与设计',
    items: [
      { name: 'Lovart', note: '视觉设计的 AI 助手，海报、配图、品牌物料。' },
      { name: '小红书 / 朋友圈', note: '每天一篇学习感悟的输出阵地，坚持一年多。' },
    ],
  },
];
---

<BaseLayout title="我的 AI 工具箱" description="宋村博士的 Uses 页面：一个非科班中年人日常使用的 AI 工具清单与真实评价。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10">
      <p class="text-[10px] tracking-widest uppercase opacity-40 mb-2" style="color: var(--color-text-muted);">
        Uses
      </p>
      <h1 class="text-3xl font-bold mb-4" style="color: var(--color-text); font-family: var(--font-serif);">
        我的 AI 工具箱
      </h1>
      <p class="text-sm leading-relaxed opacity-70 max-w-lg" style="color: var(--color-text-muted);">
        这些是我每天真实在用的工具。没有赞助，没有推广，只有一个重度用户的诚实评价。
        工具会换，但「把 AI 变成稳定工作流」这件事不会变。
      </p>
    </header>

    <div class="space-y-10">
      {sections.map(section => (
        <section>
          <h2 class="text-lg font-semibold mb-4 pb-2 border-b"
              style="color: var(--color-text); font-family: var(--font-serif); border-color: var(--color-border);">
            {section.title}
          </h2>
          <dl class="space-y-3">
            {section.items.map(item => (
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                <dt class="font-medium text-sm shrink-0 sm:w-36" style="color: var(--color-accent);">
                  {item.name}
                </dt>
                <dd class="text-sm opacity-75 leading-relaxed" style="color: var(--color-text-muted);">
                  {item.note}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <p class="mt-14 text-center text-sm opacity-50 leading-loose" style="color: var(--color-text-muted); font-family: var(--font-serif);">
      工具只是酒器，<br />重要的是里面装的东西。
    </p>
  </div>
</BaseLayout>
