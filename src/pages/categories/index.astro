---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPublished, CATEGORY_META, url } from '../../lib/utils';

const posts = filterPublished(await getCollection('posts'));
const counts: Record<string, number> = {};
for (const p of posts) {
  counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
}
---

<BaseLayout title="分类" description="宋村清酒小酒馆的六个分区：AI 清酒、人生下半场、职场手记、工业与能源、创业小酌、人间杂谈。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10">
      <h1 class="text-3xl font-bold mb-3" style="color: var(--color-text); font-family: var(--font-serif);">
        酒馆分区
      </h1>
      <p class="text-sm opacity-60" style="color: var(--color-text-muted);">
        六个角落，各有各的味道。
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {Object.entries(CATEGORY_META).map(([name, meta]) => (
        <a href={url(`/categories/${meta.slug}`)}
           class="group p-6 rounded-lg border transition-all hover:shadow-sm hover:-translate-y-0.5"
           style="border-color: var(--color-border); background: var(--color-bg-secondary);">
          <div class="flex items-baseline justify-between mb-2">
            <h2 class="text-lg font-semibold" style="color: var(--color-text); font-family: var(--font-serif);">
              {name}
            </h2>
            <span class="text-xs opacity-50" style="color: var(--color-text-muted);">
              {counts[name] ?? 0} 篇
            </span>
          </div>
          <p class="text-xs leading-relaxed opacity-70" style="color: var(--color-text-muted);">
            {meta.desc}
          </p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
